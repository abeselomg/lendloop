{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,convex \"next dev\" \"convex dev\"",
    "dev:next": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "n8n:up": "docker compose -f n8n/docker-compose.yml --env-file n8n/.env up -d",
    "n8n:down": "docker compose -f n8n/docker-compose.yml --env-file n8n/.env down",
    "n8n:import": "node n8n/scripts/import.mjs",
    "seed": "convex run seed:demo"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.25",
    "convex": "1.49.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "convex-test": "0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
