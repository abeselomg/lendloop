# Copy to n8n/.env and fill in. n8n/.env is gitignored; never commit real values.
# Generate each secret/key with: openssl rand -hex 32

# Encrypts credentials stored in n8n's database. Do not change after first start.
N8N_ENCRYPTION_KEY=
# Shared secret Convex uses to sign events sent to n8n. Must equal CONVEX_TO_N8N_SECRET in the Convex deployment.
CONVEX_TO_N8N_SECRET=
# Shared secret n8n uses to sign write-backs to Convex. Must equal N8N_TO_CONVEX_SECRET in the Convex deployment.
N8N_TO_CONVEX_SECRET=
# Base URL of the Convex HTTP actions (.convex.site). Local backend default shown (reached from the container).
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
# true sends real email via Resend; false logs mock notifications (fully offline, see `docker compose logs n8n`).
LENDLOOP_EMAIL_ENABLED=false
# From address for Resend emails (onboarding@resend.dev works for testing to your own address).
LENDLOOP_EMAIL_FROM=LendLoop <onboarding@resend.dev>
# Resend API key. IMPORT-TIME ONLY: read by `npm run n8n:import` and stored as an encrypted n8n credential; not passed to the container. Leave blank for mock mode.
RESEND_API_KEY=
# Public URL n8n is reachable at (used for webhook URLs). Optional.
N8N_PUBLIC_URL=http://localhost:5678
